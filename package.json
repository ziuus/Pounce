{
  "name": "pounce-core",
  "version": "0.1.0",
  "description": "Deterministic keyboard-first target ranking and numeric hints",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "typescript": "5.7.3"
  }
}
